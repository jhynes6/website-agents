{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "A/B Test Agent Systems",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/scripts/ab_test_agent_systems.py",
            "cwd": "${workspaceFolder}/backend",
            "args": [
                "--client",
                "nextlevel-thinking",
                "--output",
                "nextlevel-thinking_ab_test.json"
            ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "envFile": "${workspaceFolder}/backend/.env",
            "python": "${workspaceFolder}/backend/venv/bin/python"
        },
        
        {
            "name": "Debug FastAPI (backend)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/backend",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            },
            "envFile": "${workspaceFolder}/backend/.env",
            "python": "${workspaceFolder}/backend/venv/bin/python"
        },
        {
            "name": "Debug Next.js (frontend)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "env": {
                "NEXT_PUBLIC_BACKEND_URL": "http://127.0.0.1:8000"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Current File (backend venv)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/backend",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/backend/.env",
            "python": "${workspaceFolder}/backend/venv/bin/python"
        }
    ],
    "compounds": [
        {
            "name": "Debug Frontend + Backend",
            "configurations": [
                "Debug FastAPI (backend)",
                "Debug Next.js (frontend)"
            ]
        }
    ]
}