# Copy this file to `.env.local` (repo root) and fill in real values.
# The backend (`backend/app/config.py`) loads `backend/.env`, `backend/.env.local`,
# `.env`, and `.env.local` (plus a couple parent-dir fallbacks).

# Firecrawl
FIRECRAWL_API_KEY=
# Optional overrides
FIRECRAWL_BASE_URL=
FIRECRAWL_POLL_INTERVAL_MS=
FIRECRAWL_POLL_TIMEOUT_MS=

# Frontend -> backend
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# OpenAI / LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: Disable chatbot creation (for read-only deployments)
DISABLE_CHATBOT_CREATION=

#
# NOTE: Upstash and DigitalOcean are no longer used in this project.
# (We use Supabase for storage/relational data and Pinecone for vector search.)

# OpenSearch (if used)
OS_USER=
OS_PASS=
OS_URL=

# Email Bison
BISON_API_KEY=
BISON_SUPABASE_PROJECT_URL=
BISON_SUPABASE_ANON_KEY=
BISON_SUPABASE_BISON_DB_URL=
BISON_user=
BISON_password=
BISON_host=
BISON_port=
BISON_dbname=

# Supabase Agents Project Configuration (mintleads-agents)
SUPABASE_AGENT_URL=
# NOTE: For server-side bucket creation/uploads, this should usually be a service-role key.
SUPABASE_AGENT_KEY=
# Optional: Modern publishable key (client-side)
SUPABASE_AGENT_PUBLISHABLE_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_KB_INDEX=sb-knowledge-bases
PINECONE_AGENT_INDEX=agents
PINECONE_KB_HOST=
PINECONE_AGENT_HOST=
PINECONE_ASSISTANT_URL=
PINECONE_PROJECT_ID=


