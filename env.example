# Copy this file to `.env.local` (repo root) and fill in real values.
# The backend (`backend/app/config.py`) loads `backend/.env`, `backend/.env.local`,
# `.env`, and `.env.local` (plus a couple parent-dir fallbacks).

# Firecrawl
FIRECRAWL_API_KEY=
# Optional overrides
FIRECRAWL_BASE_URL=
FIRECRAWL_POLL_INTERVAL_MS=
FIRECRAWL_POLL_TIMEOUT_MS=

# Frontend -> backend
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# OpenAI / LLM provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional: Disable chatbot creation (for read-only deployments)
DISABLE_CHATBOT_CREATION=

# Upstash Vector DB / Redis (legacy)
UPSTASH_SEARCH_REST_URL=
UPSTASH_SEARCH_REST_TOKEN=
UPSTASH_SEARCH_INDEX=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# DigitalOcean
DIGITALOCEAN_TOKEN=
DIGITALOCEAN_PROJECT_ID=
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_REGION=tor1
DIGITALOCEAN_SPACES_BUCKET=

# DigitalOcean Gradient / GenAI
GRADIENT_ACCESS_TOKEN=
DIGITALOCEAN_WORKSPACE_UUID=
DIGITALOCEAN_OPENAI_KEY_UUID=
DIGITALOCEAN_AGENT_MODEL_UUID=
DIGITAL_OCEAN_MODEL_ACCESS_KEY=
DIGITAL_OCEAN_ENABLE_ADVANCED_CHUNKING=
DIGITAL_OCEAN_CHUNKING_ALGORITHM=
DIGITAL_OCEAN_AGENT_RETRIEVAL_METHOD=

# OpenSearch (if used)
OS_USER=
OS_PASS=
OS_URL=

# Email Bison
BISON_API_KEY=
BISON_SUPABASE_PROJECT_URL=
BISON_SUPABASE_ANON_KEY=
BISON_SUPABASE_BISON_DB_URL=
BISON_user=
BISON_password=
BISON_host=
BISON_port=
BISON_dbname=

# Pinecone
PINECONE_API_KEY=
PINECONE_KB_INDEX=client-knowledge-bases
PINECONE_AGENT_INDEX=agents
PINECONE_KB_HOST=
PINECONE_AGENT_HOST=
PINECONE_ASSISTANT_URL=
PINECONE_PROJECT_ID=


