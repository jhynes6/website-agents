# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (keep secrets out of git)
.env
.env.local
.env.*
backend/.env
backend/.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]
backend/venv/
.venv/

# secrets
service_account.json

# local data backups
data/supabase_backup/

.agents/pinecone-agents-ref

# Large files
backend/lawson_case_study_2023.pdf
pinecone-assistant/node_modules/
