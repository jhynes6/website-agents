#!/usr/bin/env bash
# Heroku Python buildpack post-compile hook.
# Runs after `pip install -r requirements.txt` during slug compilation.
# Installs Playwright's Chromium browser binary so it is baked into the slug.

set -eo pipefail

echo "-----> Installing Playwright Chromium browser"

# Keep browsers inside the app directory so the path is predictable
# at both build time and runtime. Match this value in the Heroku config var:
#   heroku config:set PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-/app/.playwright-browsers}"

python -m playwright install chromium --with-deps

echo "-----> Playwright Chromium installed to $PLAYWRIGHT_BROWSERS_PATH"
